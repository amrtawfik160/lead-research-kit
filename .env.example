# Environment variable NAMES only — keep filled credentials outside the repository!
# scripts/release_check.py rejects non-empty values in .env.example or any .env file inside the source tree.

# ---------------------------------------------------------------------------
# Workspace & Local Runtime (Optional)
# ---------------------------------------------------------------------------
# Path to a private workspace directory outside this repo (default: sample mode in dashboard, ./workspace in CLI)
LEAD_RESEARCH_WORKSPACE=
# Force sample mode in the dashboard ("1"/"true" or "0"/"false")
LEAD_RESEARCH_SAMPLE=
# Custom DNS servers for MX checks (comma-separated IPs; optional)
LEAD_RESEARCH_DNS_SERVERS=
# Loopback origin for dashboard server-side API fetches (default: http://127.0.0.1:8787)
DASHBOARD_API_ORIGIN=

# ---------------------------------------------------------------------------
# Public Records (Optional / Conditional)
# ---------------------------------------------------------------------------
# Required ONLY when fetching sec-form-d (format: "Your Name you@example.com")
SEC_USER_AGENT=
# Optional Socrata app token for higher rate limits on tx-trec, ny-dos, co-dora, ct-dls
SOCRATA_APP_TOKEN=

# ---------------------------------------------------------------------------
# Search & Domain Resolution Providers (Required only when that provider is enabled)
# ---------------------------------------------------------------------------
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
ZENSERP_API_KEY=
LINKUP_API_KEY=
YDC_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# Company & People Discovery Providers (Required only when that provider is enabled)
# ---------------------------------------------------------------------------
HUNTER_API_KEY=
GOOGLE_MAPS_API_KEY=
APOLLO_API_KEY=
PROSPEO_API_KEY=
PDL_API_KEY=
APIFY_API_TOKEN=

# ---------------------------------------------------------------------------
# Page Reading / Crawling (Optional)
# ---------------------------------------------------------------------------
# Jina Reader works keyless; set JINA_API_KEY optionally for higher rate limits
JINA_API_KEY=

# ---------------------------------------------------------------------------
# Email Finder Providers (Required only when that provider is enabled)
# ---------------------------------------------------------------------------
ZEROBOUNCE_API_KEY=
# Tomba requires both key and secret
TOMBA_API_KEY=
TOMBA_SECRET=
ICYPEAS_API_KEY=
DEEPLINE_API_KEY=
# Optional Deepline route: "finder" (default) or "waterfall"
DEEPLINE_FIND_ROUTE=
ENROW_API_KEY=
# Lusha: paid plans only (no API on Free)
LUSHA_API_KEY=
SKRAPP_API_KEY=

# ---------------------------------------------------------------------------
# Email Verification Providers (Required only when that provider is enabled)
# ---------------------------------------------------------------------------
REOON_API_KEY=
# Verifalia: set VERIFALIA_TOKEN, or both VERIFALIA_USERNAME and VERIFALIA_PASSWORD
VERIFALIA_TOKEN=
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=
CLEAROUT_API_KEY=
MILLIONVERIFIER_API_KEY=
ABSTRACT_EMAIL_API_KEY=
EMAILABLE_API_KEY=
KICKBOX_API_KEY=
BOUNCER_API_KEY=
MYEMAILVERIFIER_API_KEY=
QUICKEMAILVERIFICATION_API_KEY=
EMAILVALIDATION_API_KEY=
EMAILLISTVERIFY_API_KEY=

# ---------------------------------------------------------------------------
# Signals / Watch Providers (Required only when that provider is enabled; hackernews/disify/hunter-insight/overpass need no key)
# ---------------------------------------------------------------------------
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=
